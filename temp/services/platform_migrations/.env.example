################################################################################
# REQUIRED — the service fails at startup, naming the variable, when any is missing
################################################################################
# Credential-free async URL for the platform PostgreSQL database.
PLATFORM_DATABASE_URL=postgresql+asyncpg://platform@127.0.0.1:5433/platform
# LOCAL ONLY secret payload; ECS injects this variable from SSM in AWS.
PLATFORM_DB_PASSWORD=local-platform-password

################################################################################
# BOOTSTRAP_REQUIRED — used only by the database-bootstrap command
################################################################################
# LOCAL ONLY JSON representation of the RDS-managed admin secret for bootstrap runs.
RDS_ADMIN_SECRET_JSON={"username":"platform","password":"local-platform-password","host":"127.0.0.1","port":5433}

################################################################################
# OVERRIDABLE — this one-shot service has no application-policy YAML
################################################################################

################################################################################
# OPTIONAL — this one-shot service has no optional runtime inputs
################################################################################
