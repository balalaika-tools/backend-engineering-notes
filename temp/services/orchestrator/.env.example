################################################################################
# REQUIRED — the service fails at startup, naming the variable, when any is missing
################################################################################
# Selects repository-root config layers; there is no implicit environment.
ENVIRONMENT_NAME=local
# Credential-free platform PostgreSQL URL; the password is resolved separately.
PLATFORM_DATABASE_URL=postgresql+asyncpg://platform@127.0.0.1:5433/platform
# Read-only CTC topology; credentials are injected separately.
CTC_DATABASE_URL=postgresql+asyncpg://ctc_reader@127.0.0.1:5542/ctc
CTC_RECONCILIATION_SCHEMA=webuiPositions
CTC_DB_PASSWORD=local-ctc-password
# NATS server provisioned by the deployment environment.
NATS_URL=nats://127.0.0.1:4222
NATS_AUTH_TOKEN=local-dev-token
# Object-store bucket provisioned by deployment tooling.
S3_BUCKET=exception-investigation
# JWT issuer base URL used to discover JWKS.
COGNITO_ISSUER=http://127.0.0.1:8081/default
# Allowed Cognito machine-client identifier, compared with the access token client_id.
COGNITO_AUDIENCE=exception-investigation
# LOCAL ONLY secret payload; ECS injects this variable from SSM in AWS.
PLATFORM_DB_PASSWORD=local-platform-password
################################################################################
# OVERRIDABLE — application policy baselined in repository-root config/
################################################################################
# Independent CTC pool and bounded selection policy.
# CTC_POOL_MAX_SIZE=2
# CTC_ACQUISITION_TIMEOUT_SECONDS=5
# CTC_STATEMENT_TIMEOUT_SECONDS=5
# CTC_SCAN_PAGE_SIZE=100
# MAX_BULK_EXCEPTIONS=100
# Structured logging level.
# LOG_LEVEL=DEBUG
# CTC tenant token.
# TENANT_TOKEN=WEBUI
# Positions control name.
# POSITIONS_CONTROL=Positions
# Reference control name.
# REFERENCE_CONTROL=Reference
# CTC exception type name.
# EXCEPTION_NAME=Break
# Shared trigger and status endpoint batch limit.
# MAX_INVESTIGATION_BATCH_SIZE=100
# Reports endpoint batch limit.
# MAX_REPORT_BATCH_SIZE=10
# Maximum report size retained inline.
# REPORT_INLINE_LIMIT=256KB
# Maximum platform database pool size.
# PLATFORM_POOL_MAX_SIZE=10
# Outbox publisher polling interval.
# OUTBOX_POLL_INTERVAL_SECONDS=0.5
# Outbox publisher batch size.
# OUTBOX_BATCH_SIZE=100
# Historical platform database retention in days.
# DATABASE_RETENTION_DAYS=90
# Object key prefix for cached manuals.
# MANUAL_KEY_PREFIX=manuals
# JetStream stream name.
# NATS_STREAM=EXCEPTION_INVESTIGATIONS
# Investigation event subject.
# NATS_SUBJECT=investigations.requested
# JWKS cache lifetime in seconds.
# JWKS_CACHE_TTL_SECONDS=300

################################################################################
# OPTIONAL — rare runtime-only variables for specific situations
################################################################################
# S3-compatible endpoint used by local MinIO; AWS S3 needs no override.
# S3_ENDPOINT=http://127.0.0.1:9000
# OTLP collector endpoint; telemetry is disabled when unset.
# OTLP_ENDPOINT=http://127.0.0.1:4318
# Explicit instance identity; the container hostname is used when unset.
# SERVICE_INSTANCE_ID=orchestrator-local
# SERVICE_NAMESPACE=exception-investigation
# SERVICE_VERSION=unknown
# LOG_FULL_EXCEPTION_TRACE=true
# OTEL_EXPORT_INTERVAL_MILLIS=15000
# LOCAL ONLY S3-compatible access key; deployed workloads use runtime identity.
# S3_ACCESS_KEY_ID=minioadmin
# LOCAL ONLY S3-compatible secret key; deployed workloads use runtime identity.
# S3_SECRET_ACCESS_KEY=minioadmin
# Escape hatch when the service baseline cannot be discovered.
# ORCHESTRATOR_CONFIG_DIR=config
