################################################################################
# REQUIRED — the service fails at startup, naming the variable, when any is missing
################################################################################
# Selects repository-root config layers; there is no implicit environment.
ENVIRONMENT_NAME=local
# Shared cache namespace. Deployment tooling supplies a new value for every rollout.
DEPLOYMENT_RELEASE_ID=local-v1
# Credential-free platform PostgreSQL URL; the password is resolved separately.
PLATFORM_DATABASE_URL=postgresql+asyncpg://platform@127.0.0.1:5433/platform
# Credential-free CTC PostgreSQL URL; the password is resolved separately.
CTC_DATABASE_URL=postgresql+asyncpg://ctc_reader@127.0.0.1:5542/ctc
# NATS server provisioned by the deployment environment.
NATS_URL=nats://127.0.0.1:4222
NATS_AUTH_TOKEN=local-dev-token
# Redis server used for the shared control context and provider cooldown.
REDIS_URL=redis://127.0.0.1:6379/0
# Object-store bucket provisioned by deployment tooling.
S3_BUCKET=exception-investigation
# CTC OAuth2 token issuer; this host can differ from the API host.
CTC_ISSUER_URL=http://127.0.0.1:8081/ctc/token
# CTC REST API base host.
CTC_API_BASE_URL=http://127.0.0.1:8083
# Public OAuth2 client identifier for the CTC API.
CTC_CLIENT_ID=exception-investigation-worker
# Runtime-selected analysis model.
ANALYSIS_MODEL_ID=replace-me-analysis-model
# Runtime-selected control-configuration summarizer model.
SUMMARIZER_MODEL_ID=replace-me-summarizer-model
# Runtime-selected SQL repair model.
SQL_FIXER_MODEL_ID=replace-me-sql-fixer-model
# Runtime region for the selected model provider.
MODEL_REGION=eu-west-1
# LOCAL ONLY platform database secret payload; ECS injects this variable from SSM in AWS.
PLATFORM_DB_PASSWORD=local-platform-password
# LOCAL ONLY CTC database secret payload; ECS injects this variable from SSM in AWS.
CTC_DB_PASSWORD=local-ctc-password
# LOCAL ONLY CTC OAuth2 secret payload; ECS injects this variable from SSM in AWS.
CTC_CLIENT_SECRET=local-ctc-client-secret

################################################################################
# OVERRIDABLE — application policy baselined in repository-root config/
################################################################################
# LOG_LEVEL=DEBUG
# TENANT_TOKEN=WEBUI
# POSITIONS_CONTROL=Positions
# REFERENCE_CONTROL=Reference
# EXCEPTION_NAME=Break
# NATS_STREAM=EXCEPTION_INVESTIGATIONS
# NATS_CONSUMER=INVESTIGATION_WORKERS
# NATS_SUBJECT=investigations.requested
# FETCH_TIMEOUT_SECONDS=5
# HEARTBEAT_INTERVAL_SECONDS=20
# ACK_WAIT_SECONDS=60
# LEASE_SECONDS=90
# MAX_ATTEMPTS=5
# MAX_DELIVER=6
# MAX_ACK_PENDING=75
# SHUTDOWN_GRACE_SECONDS=90
# DUPLICATE_WINDOW_SECONDS=120
# REPORT_INLINE_LIMIT=256KB
# REPORT_KEY_PREFIX=reports
# MANUAL_KEY_PREFIX=manuals
# PLATFORM_POOL_MAX_SIZE=5
# CTC_POOL_MAX_SIZE=5
# CTC_STATEMENT_TIMEOUT_SECONDS=30
# CTC_WORK_MEM=64MB
# CTC_QUERY_ROW_LIMIT=50
# RECONCILE_INTERVAL_SECONDS=60
# DATABASE_RETENTION_DAYS=90
# WINDOW_SECONDS=30
# MIN_SAMPLES=20
# STABLE_THRESHOLD=0.01
# DECREASE_THRESHOLD=0.05
# BREAK_THRESHOLD=0.5
# INCREASE_STEP_MIN=3
# INCREASE_STEP_MAX=7
# DECREASE_FACTOR=0.7
# INITIAL_TARGET=10
# MIN_INFLIGHT=2
# MAX_PER_INSTANCE=50
# LLM_MAX_ATTEMPTS=8
# LLM_BACKOFF_BASE_SECONDS=1
# LLM_BACKOFF_CAP_SECONDS=30
# COOLDOWN_SECONDS=60
# CONTROL_CONTEXT_CACHE_PREFIX=control-context
# CONTROL_CONTEXT_REBUILD_LEASE_SECONDS=600
# CONTROL_CONTEXT_REBUILD_WAIT_SECONDS=620
# CONTROL_CONTEXT_POLL_INTERVAL_SECONDS=0.2
# INVESTIGATION_RETRY_DELAYS_SECONDS=[60,120,300,300]
# RECORD_COMMENT_LIMIT=200
# ANALYSIS_MODEL_CALL_LIMIT=25
# ANALYSIS_TOOL_CALL_LIMIT=50
# ANALYSIS_SUMMARIZATION_TRIGGER_TOKENS=100000
# ANALYSIS_SUMMARIZATION_KEEP_MESSAGES=2
# SQL_FIXER_MAX_ATTEMPTS=3
# SUMMARIZER_PROMPT_VERSION=v1
# ANALYSIS_PROMPT_VERSION=v1
# COMMENT_WRITE_ENABLED=true
# CODES_WRITE_ENABLED=false

################################################################################
# OPTIONAL — rare runtime-only variables for specific situations
################################################################################
# S3-compatible endpoint used by local MinIO; AWS S3 needs no override.
# S3_ENDPOINT=http://127.0.0.1:9000
# AWS only: enable short-lived ElastiCache IAM credentials and identify the cache/user.
# REDIS_IAM_AUTH_ENABLED=true
# REDIS_IAM_USER_ID=ai-exception-dev-platform
# REDIS_CACHE_NAME=ai-exception-dev-redis
# REDIS_REGION=eu-west-1
# OTLP collector endpoint; telemetry is disabled when unset.
# OTLP_ENDPOINT=http://127.0.0.1:4318
# Explicit instance identity; the container hostname is used when unset.
# SERVICE_INSTANCE_ID=worker-local
# SERVICE_NAMESPACE=exception-investigation
# SERVICE_VERSION=unknown
# CAPTURE_AI_CONTENT=false
# LOG_FULL_EXCEPTION_TRACE=true
# OTEL_EXPORT_INTERVAL_MILLIS=15000
# LOCAL ONLY S3-compatible access key; deployed workloads use runtime identity.
# S3_ACCESS_KEY_ID=minioadmin
# LOCAL ONLY S3-compatible secret key; deployed workloads use runtime identity.
# S3_SECRET_ACCESS_KEY=minioadmin
# Escape hatch when the service baseline cannot be discovered.
# WORKER_CONFIG_DIR=config
